{
  "manifest_version": 3,
  "name": "Link Sanitizer",
  "version": "1.1.1",
  "description": "Remove tracking parameters and the Referer from links, per source site. Pre-set for ChatGPT. No data collected.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Link Sanitizer" }
}
